# ROVSKA — configuración de ejemplo.
# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.

# --- API / panel web -------------------------------------------------------
ROVSKA_HOST=127.0.0.1
ROVSKA_PORT=8780

# Token opcional para operaciones que modifican estado. Si está vacío, el
# panel funciona en local sin token (solo escucha en 127.0.0.1 por defecto).
ROVSKA_API_TOKEN=

# --- Ejecución de herramientas --------------------------------------------
# local  -> usa las herramientas instaladas en el host (solo nmap, etc.)
# docker -> ejecuta dentro del contenedor Kali (recomendado)
ROVSKA_RUNNER=docker
ROVSKA_CONTAINER=rovska-kali

# Directorio de datos (SQLite, informes, evidencias y trabajo). El compose
# monta este mismo directorio en /data; si lo cambias, reinicia el contenedor.
# ROVSKA_DATA_DIR=/home/usuario/ROVSKA/data

# --- Seguridad / alcance ---------------------------------------------------
# Lista separada por comas de CIDR públicos permitidos. Solo se aplica cuando
# ROVSKA_ALLOW_PUBLIC=1: si está vacía se permite cualquier público con
# authorization=true; si tiene valores, el objetivo debe estar dentro de uno.
# Ejemplo: 203.0.113.0/24,198.51.100.0/24
ROVSKA_ALLOWED_CIDRS=
# Permitir objetivos públicos (¡solo con autorización expresa!).
ROVSKA_ALLOW_PUBLIC=0
# Habilitar operaciones ofensivas reales (hydra/metasploit con execute=true).
ROVSKA_ALLOW_ATTACK=0
# Máximo de hosts que se pueden expandir en un barrido.
ROVSKA_MAX_HOSTS=256
# Timeout por herramienta, en segundos.
ROVSKA_TOOL_TIMEOUT=900

# --- Proxmox (opcional, API de solo lectura) -------------------------------
# También se puede configurar desde Ajustes -> Proxmox. El fichero
# data/proxmox.json (permisos 600) tiene prioridad sobre estas variables.
# Crea un token con rol PVEAuditor; el panel solo hace peticiones GET.
# ROVSKA_PROXMOX_ENDPOINT=https://192.168.88.10:8006
# ROVSKA_PROXMOX_TOKEN_ID=PVEAuditor@pve!rovska
# ROVSKA_PROXMOX_TOKEN_SECRET=
# ROVSKA_PROXMOX_ENABLED=0
# ROVSKA_PROXMOX_VERIFY_TLS=1
# ROVSKA_PROXMOX_INCLUDE_IN_SCANS=1

# --- OpenCode como orquestador --------------------------------------------
ROVSKA_OPENCODE_ENABLED=0
ROVSKA_OPENCODE_BIN=opencode
ROVSKA_OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
ROVSKA_OPENCODE_TIMEOUT=300
